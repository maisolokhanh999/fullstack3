# Sao chép file này thành .env rồi điền giá trị thật. Không commit .env.

# MongoDB — dùng replica set hoặc Atlas để hỗ trợ transaction. Ba biến còn lại chỉ là alias fallback trong
# configs/db.js, giữ lại cho tương thích ngược; môi trường mới chỉ cần MONGODB_URL.
MONGODB_URL=
MONGODB_URI=
MONGO_URI=
CONST_MONGODB_URL=

# Cổng HTTP. Mặc định 5000 nếu bỏ trống.
PORT=

# Nhãn người thao tác được lưu trong sổ chứng từ.
ERP_ACTOR_NAME=erp-api

# Ảnh chứng từ chuyển khoản được lưu trên Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
